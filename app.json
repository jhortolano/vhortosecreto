{
  "expo": {
    "name": "Voto Secreto",
    "slug": "VhortoSecreto",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vhortosecreto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.termibululu.vhortosecreto",
      "buildNumber": "9",
      "associatedDomains": ["applinks:vhortosecreto.vercel.app"],
      "infoPlist": {
        "CFBundleDisplayName": "Voto Secreto",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.termibululu.vhortosecreto",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "vhortosecreto",
              "host": "open",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "vhortosecreto.vercel.app",
              "pathPrefix": "/open"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
